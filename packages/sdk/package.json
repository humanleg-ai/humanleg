{
  "name": "@humanleg/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the HumanLeg.ai public agent API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
