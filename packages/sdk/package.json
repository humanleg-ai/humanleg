  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanleg-ai/humanleg.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
