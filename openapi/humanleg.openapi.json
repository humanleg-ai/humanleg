        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "patch": {
        "tags": ["agent", "compliance"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expectedVersion",
                  "title",
                  "instructions",
                  "evidenceRequirements",
                  "deadline"
                ],
                "properties": {
                  "expectedVersion": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "title": {
                    "minLength": 3,
                    "maxLength": 160,
                    "type": "string"
                  },
                  "instructions": {
                    "minLength": 10,
                    "maxLength": 10000,
                    "type": "string"
                  },
                  "evidenceRequirements": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "deadline": {
                    "format": "date-time",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "minLength": 8,
              "maxLength": 255,
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
